[Unit]
Description=CCTV Telegram bot (kontrol arming + notifikasi)
After=network-online.target

[Service]
WorkingDirectory=%h/Dev/cctv-keamanan-open
ExecStart=%h/.local/bin/uv run --env-file .env bot/run_bot.py
Restart=always
RestartSec=3
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
