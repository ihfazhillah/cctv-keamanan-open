[Unit]
Description=CCTV shadow segment recorder (A/V, proof-of-concept)
After=network-online.target

[Service]
WorkingDirectory=/home/USER/Dev/cctv-keamanan-open
ExecStart=/home/USER/.local/bin/uv run --env-file .env segrec/run_segrec.py
Restart=always
RestartSec=3
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
