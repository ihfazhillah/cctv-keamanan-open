[Unit]
Description=CCTV supervisor — semua kamera dari cameras.json (taman penuh + garasi ringan)
After=network-online.target

[Service]
WorkingDirectory=%h/Dev/cctv-keamanan-open
ExecStart=%h/.local/bin/uv run --env-file .env pipeline/run_supervisor.py --cameras-file cameras.json
Restart=always
RestartSec=3
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
