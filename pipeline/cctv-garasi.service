[Unit]
Description=CCTV garasi — detektor orang ringan (gated by jadwal, notif via bot)
After=network-online.target

[Service]
WorkingDirectory=%h/Dev/cctv-keamanan-open
ExecStart=%h/.local/bin/uv run --env-file .env pipeline/run_garasi.py --cameras-file cameras.json
Restart=always
RestartSec=3
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
